rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{uid} {

      allow read: if signedIn();

      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly([
                      "name",
                      "nameLower",
                      "bio",
                      "initials",
                      "teach",
                      "teachIds",
                      "learn",
                      "learnIds",
                      "profileComplete",
                      "xp",
                      "createdAt",
                      "updatedAt"
                    ])
                    && request.resource.data.xp == 0;

      allow update: if isOwner(uid)
                    && (

                      // Normal profile editing
                      request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                          "name",
                          "nameLower",
                          "bio",
                          "initials",
                          "teach",
                          "teachIds",
                          "learn",
                          "learnIds",
                          "profileComplete",
                          "createdAt",
                          "updatedAt"
                        ])

                      ||

                      // Initialize XP for old profile
                      (
                        !resource.data.keys().hasAny(["xp"])
                        && request.resource.data.xp == 0
                        && request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly([
                             "xp",
                             "updatedAt"
                           ])
                      )

                      ||

                      // Session XP
                      (
                        request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            "xp",
                            "lastXpEventId",
                            "updatedAt"
                          ])

                        && request.resource.data.lastXpEventId is string

                        && (
                          request.resource.data.xp ==
                            resource.data.xp + 20
                          ||
                          request.resource.data.xp ==
                            resource.data.xp + 30
                        )

                        && getAfter(
                          /databases/$(database)/documents/xpEvents/$(request.resource.data.lastXpEventId)
                        ).data.uid == uid

                        && getAfter(
                          /databases/$(database)/documents/xpEvents/$(request.resource.data.lastXpEventId)
                        ).data.xp ==
                          request.resource.data.xp - resource.data.xp
                      )

                      ||

                      // Daily Login XP
                      (
                        request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            "xp",
                            "dailyLoginDate",
                            "updatedAt"
                          ])

                        && (
                          (
                            !resource.data.keys().hasAny(["xp"])
                            && request.resource.data.xp == 10
                          )

                          ||

                          (
                            resource.data.keys().hasAny(["xp"])
                            && request.resource.data.xp ==
                               resource.data.xp + 10
                          )
                        )

                        && request.resource.data.dailyLoginDate is string

                        && (
                          !resource.data.keys().hasAny(["dailyLoginDate"])
                          ||
                          request.resource.data.dailyLoginDate !=
                            resource.data.dailyLoginDate
                        )
                      )
                    );
    }


    // =========================================================
    // SESSION XP EVENTS
    // =========================================================

    match /xpEvents/{eventId} {

      allow read: if signedIn();

      allow create: if signedIn()

                    && request.resource.data.keys().hasOnly([
                      "uid",
                      "sessionId",
                      "type",
                      "xp",
                      "createdAt"
                    ])

                    && request.resource.data.uid == request.auth.uid

                    && request.resource.data.sessionId is string

                    && request.resource.data.type is string

                    && (
                      request.resource.data.type == "teaching"
                      ||
                      request.resource.data.type == "learning"
                    )

                    && (
                      request.resource.data.xp == 20
                      ||
                      request.resource.data.xp == 30
                    )

                    && exists(
                      /databases/$(database)/documents/sessions/$(request.resource.data.sessionId)
                    )

                    && get(
                      /databases/$(database)/documents/sessions/$(request.resource.data.sessionId)
                    ).data.status == "completed"

                    && get(
                      /databases/$(database)/documents/sessions/$(request.resource.data.sessionId)
                    ).data.confirmedBy.size() == 2

                    && (
                      (
                        request.resource.data.type == "teaching"
                        &&
                        request.resource.data.xp == 30
                        &&
                        get(
                          /databases/$(database)/documents/sessions/$(request.resource.data.sessionId)
                        ).data.teacherId == request.auth.uid
                      )

                      ||

                      (
                        request.resource.data.type == "learning"
                        &&
                        request.resource.data.xp == 20
                        &&
                        get(
                          /databases/$(database)/documents/sessions/$(request.resource.data.sessionId)
                        ).data.learnerId == request.auth.uid
                      )
                    );

      allow update, delete: if false;
    }


    // =========================================================
    // OLD DAILY XP EVENTS
    // =========================================================

    match /dailyXpEvents/{eventId} {

      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly([
                      "uid",
                      "type",
                      "xp",
                      "year",
                      "month",
                      "day",
                      "createdAt"
                    ])

                    && request.resource.data.uid == request.auth.uid

                    && request.resource.data.type == "dailyLogin"

                    && request.resource.data.xp == 10

                    && request.resource.data.year == request.time.year()

                    && request.resource.data.month == request.time.month()

                    && request.resource.data.day == request.time.day()

                    && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }


    // =========================================================
    // DAILY XP
    // =========================================================

    match /dailyXp/{docId} {

      allow read: if signedIn();

      allow create, update, delete: if false;
    }


    // =========================================================
    // REVIEWS
    // =========================================================

    match /reviews/{reviewId} {

      allow read: if signedIn();

      allow create, update, delete: if false;
    }


    // =========================================================
    // SESSIONS
    // =========================================================

    match /sessions/{sessionId} {

      allow read: if signedIn();

      allow create: if signedIn();

      allow update: if signedIn()
                    && (
                      resource.data.teacherId == request.auth.uid
                      ||
                      resource.data.learnerId == request.auth.uid
                    );

      allow delete: if false;
    }


    // =========================================================
    // CONNECTIONS
    // =========================================================

    match /connections/{connectionId} {

      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.requesterId == request.auth.uid;

      allow update: if signedIn()
                    && (
                      resource.data.requesterId == request.auth.uid
                      ||
                      resource.data.receiverId == request.auth.uid
                    );

      allow delete: if signedIn()
                    && (
                      resource.data.requesterId == request.auth.uid
                      ||
                      resource.data.receiverId == request.auth.uid
                    );
    }


    // =========================================================
    // CHAT MESSAGES INSIDE CONNECTIONS
    // =========================================================

    match /connections/{connectionId}/messages/{messageId} {

      // Only participants of the connection can read messages
      allow read: if signedIn()
                  && get(
                    /databases/$(database)/documents/connections/$(connectionId)
                  ).data.participants.hasAny([request.auth.uid]);


      // Only participants can send messages
      // and the senderId must match the logged-in user
      allow create: if signedIn()
                    && get(
                      /databases/$(database)/documents/connections/$(connectionId)
                    ).data.participants.hasAny([request.auth.uid])
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      "senderId",
                      "senderName",
                      "text",
                      "createdAt"
                    ]);


      // Messages cannot be edited or deleted
      allow update, delete: if false;
    }


    // =========================================================
    // OLD / TOP-LEVEL MESSAGES
    // =========================================================

    match /messages/{messageId} {

      allow read: if signedIn()
                  && (
                    resource.data.senderId == request.auth.uid
                    ||
                    resource.data.receiverId == request.auth.uid
                  );

      allow create: if signedIn()
                    && request.resource.data.senderId == request.auth.uid;

      allow update, delete: if false;
    }


    // =========================================================
    // EVERYTHING ELSE
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}