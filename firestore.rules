rules_version = '2';

// SkillShare 2.0 security rules.
// Key idea: the browser may REQUEST things, but only Cloud Functions can GRANT XP.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // True when the connection exists, is accepted and contains this user.
    function isAcceptedMember(connId) {
      let c = get(/databases/$(database)/documents/connections/$(connId)).data;
      return signedIn() && c.status == 'accepted' && request.auth.uid in c.participants;
    }

    // Used when creating a session: the two people must be accepted connections.
    function connectionOk(key, people) {
      let c = get(/databases/$(database)/documents/connections/$(key)).data;
      return c.status == 'accepted' && c.participants.hasAll(people);
    }

    // ---------- Profiles ----------
    // XP and levels are NOT stored here, so users cannot edit them.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'name', 'nameLower', 'bio', 'initials', 'teach', 'teachIds',
          'learn', 'learnIds', 'profileComplete', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.teach is list
        && request.resource.data.teach.size() <= 30
        && request.resource.data.learn is list
        && request.resource.data.learn.size() <= 30;
      allow delete: if false;

      // Per-skill XP and level. Written ONLY by Cloud Functions.
      match /skillStats/{skillId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // ---------- Skill catalogue and level thresholds (read-only for users) ----------
    match /skills/{skillId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- Connections ----------
    // Document id is the two user ids joined with "_" (sorted).
    match /connections/{connId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.requesterId != request.resource.data.receiverId
        && request.resource.data.status == 'pending'
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([
             request.resource.data.requesterId, request.resource.data.receiverId])
        && (connId == request.resource.data.requesterId + '_' + request.resource.data.receiverId
            || connId == request.resource.data.receiverId + '_' + request.resource.data.requesterId);

      // Only the receiver can accept a pending request.
      allow update: if signedIn()
        && resource.data.receiverId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);

      // Reject / cancel a request.
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;

      // ---------- Chat messages ----------
      match /messages/{messageId} {
        allow read: if isAcceptedMember(connId);
        allow create: if isAcceptedMember(connId)
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ---------- Sessions ----------
    // Users can create and cancel sessions. Confirming, disputing and rewards
    // all go through Cloud Functions, so they cannot be faked from the browser.
    match /sessions/{sessionId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'teacherId', 'learnerId', 'teacherName', 'learnerName', 'participants',
          'pairKey', 'skillId', 'skillName', 'date', 'time', 'durationMins',
          'startAt', 'status', 'confirmedBy', 'rewarded', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.hasAll([
             request.resource.data.teacherId, request.resource.data.learnerId])
        && request.resource.data.teacherId != request.resource.data.learnerId
        && request.resource.data.status == 'scheduled'
        && request.resource.data.confirmedBy.size() == 0
        && request.resource.data.rewarded == false
        && request.resource.data.startAt > request.time
        && request.resource.data.durationMins in [30, 45, 60, 90]
        && request.resource.data.skillId is string
        && connectionOk(request.resource.data.pairKey, request.resource.data.participants);

      // The only direct change allowed: cancel a session that is not finished.
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && resource.data.status in ['scheduled', 'pending_confirmation']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }

    // ---------- Server-written collections ----------
    match /rewards/{rewardId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /dailyXp/{docId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read, write: if false;
    }

    match /pairs/{pairId} {
      allow read, write: if false;
    }
  }
}
